<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PrivaSee — Digital Privacy Assistant</title>
  <meta name="description" content="Translate mobile app permission legalese into plain human terms. Dynamic risk scores, anomaly detection, and 1-click privacy hardening.">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
            },
            slate: {
              750: '#243247',
              850: '#141e30',
              900: '#0f172a',
              950: '#090d16',
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'],
            mono: ['JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Courier New', 'monospace'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts & FontAwesome CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }

    /* Cyber Security Grid & Ambient Atmosphere */
    .cyber-grid {
      background-image: linear-gradient(to right, rgba(51, 65, 85, 0.12) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(51, 65, 85, 0.12) 1px, transparent 1px);
      background-size: 36px 36px;
    }

    /* Smooth SVG Dial Arc */
    .gauge-progress-circle {
      transition: stroke-dashoffset 0.85s cubic-bezier(0.34, 1.56, 0.64, 1), stroke 0.4s ease;
    }

    /* Tactile Card Hover */
    .crisp-card {
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .crisp-card:hover {
      transform: translateY(-2px);
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-emerald-500 selection:text-slate-900 relative">

  <!-- Background Ambient Atmosphere -->
  <div class="fixed inset-0 cyber-grid pointer-events-none z-0"></div>
  <div class="fixed -top-40 -left-40 w-[30rem] h-[30rem] bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none z-0"></div>
  <div class="fixed top-1/2 -right-40 w-[30rem] h-[30rem] bg-indigo-500/10 rounded-full blur-[120px] pointer-events-none z-0"></div>

  <!-- App Wrapper -->
  <div class="relative z-10 flex flex-col min-h-screen">
    
    <!-- ================= 1. DECLUTTERED CLEAN NAVBAR ================= -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between gap-4">
        
        <!-- Brand & Tagline -->
        <div class="flex items-center space-x-3">
          <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 via-teal-500 to-cyan-400 p-0.5 shadow-lg shadow-emerald-500/20">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
              <i class="fa-solid fa-shield-halved text-emerald-400 text-lg"></i>
            </div>
            <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-slate-900 flex items-center justify-center">
              <div class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></div>
            </div>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent">PrivaSee</span>
            </div>
            <p class="text-xs text-slate-400 font-medium">
              Translate permission legalese into plain human terms
            </p>
          </div>
        </div>

        <!-- Right Side: Interactive Demo Tour & Scoring Rules -->
        <div class="flex items-center space-x-2.5">
          <button id="btnRunInteractiveDemo" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white border border-emerald-400/40 text-xs font-bold transition shadow-md shadow-emerald-600/20 cursor-pointer active:scale-95" title="Watch 10-second automatic demo">
            <i class="fa-solid fa-play text-[10px]"></i>
            <span>▶ 10s Guided Demo</span>
          </button>
          
          <button id="btnOpenMethodology" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700/80 text-xs font-semibold transition shadow-sm cursor-pointer" title="How PrivaSee calculates risk">
            <i class="fa-solid fa-circle-question text-emerald-400"></i>
            <span class="hidden sm:inline">Scoring Rules</span>
          </button>
        </div>

      </div>
    </header>

    <!-- Main Workspace Container (Generous Bottom Viewport Padding) -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-20 sm:pb-24 space-y-8">

      <!-- ================= 2. STREAMLINED APP SELECTOR ================= -->
      <section class="space-y-2.5">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold tracking-wider uppercase text-slate-400 flex items-center gap-1.5">
            <i class="fa-solid fa-shapes text-emerald-400"></i>
            Select an App to Inspect
          </h2>
          <span class="text-xs text-slate-400 hidden sm:inline">Click any app to load its live privacy profile</span>
        </div>

        <!-- Clean Tactile App Selector Cards (Only Icon, Name, and Standardized Risk Pill) -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" id="appSelectorContainer">
          
          <!-- App 1: TikTok -->
          <button data-app="tiktok" class="app-tab-btn group p-4 rounded-2xl border text-center flex flex-col items-center justify-center gap-2 border-slate-800 bg-slate-850 hover:border-slate-700 shadow-md transition-all cursor-pointer">
            <div class="w-12 h-12 rounded-2xl bg-black flex items-center justify-center text-white border border-slate-700 shadow-sm group-hover:scale-105 transition-transform">
              <i class="fa-brands fa-tiktok text-rose-400 text-xl"></i>
            </div>
            <div class="font-bold text-sm text-slate-100 group-hover:text-emerald-400 transition">TikTok</div>
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-rose-500/15 text-rose-400 border border-rose-500/30">Critical Risk</span>
          </button>

          <!-- App 2: Instagram -->
          <button data-app="instagram" class="app-tab-btn group p-4 rounded-2xl border text-center flex flex-col items-center justify-center gap-2 border-slate-800 bg-slate-850 hover:border-slate-700 shadow-md transition-all cursor-pointer">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
              <i class="fa-brands fa-instagram text-xl"></i>
            </div>
            <div class="font-bold text-sm text-slate-100 group-hover:text-emerald-400 transition">Instagram</div>
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30">Moderate Risk</span>
          </button>

          <!-- App 3: Flashlight Pro -->
          <button data-app="flashlight" class="app-tab-btn group p-4 rounded-2xl border text-center flex flex-col items-center justify-center gap-2 border-slate-800 bg-slate-850 hover:border-slate-700 shadow-md transition-all cursor-pointer">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 shadow-sm group-hover:scale-105 transition-transform">
              <i class="fa-solid fa-bolt text-xl"></i>
            </div>
            <div class="font-bold text-sm text-slate-100 group-hover:text-emerald-400 transition">Flashlight Pro</div>
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-rose-600 text-white animate-pulse">Critical Risk</span>
          </button>

          <!-- App 4: Signal Messenger -->
          <button data-app="signal" class="app-tab-btn group p-4 rounded-2xl border text-center flex flex-col items-center justify-center gap-2 border-slate-800 bg-slate-850 hover:border-slate-700 shadow-md transition-all cursor-pointer">
            <div class="w-12 h-12 rounded-2xl bg-blue-600 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
              <i class="fa-solid fa-comment-sms text-xl"></i>
            </div>
            <div class="font-bold text-sm text-slate-100 group-hover:text-emerald-400 transition">Signal</div>
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">Safe / Low Risk</span>
          </button>

          <!-- App 5: Custom Paste -->
          <button data-app="custom" class="app-tab-btn group p-4 rounded-2xl border text-center flex flex-col items-center justify-center gap-2 col-span-2 sm:col-span-1 border-slate-800 bg-slate-850 hover:border-slate-700 shadow-md transition-all cursor-pointer">
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shadow-sm group-hover:scale-105 transition-transform">
              <i class="fa-solid fa-terminal text-lg"></i>
            </div>
            <div class="font-bold text-sm text-slate-100 group-hover:text-emerald-400 transition">Custom Paste</div>
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">Custom</span>
          </button>

        </div>
      </section>

      <!-- Custom Paste Drawer (Visible when Custom tab is selected) -->
      <section id="customPasteDrawer" class="hidden p-5 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-xl transition-all">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-3">
          <div>
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-paste text-emerald-600"></i>
              Paste Raw Android Permission Declarations
            </h3>
            <p class="text-xs text-slate-500">Paste Android permission strings (one per line) to run an immediate plain-English translation audit.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs text-slate-500 font-medium">Test Samples:</span>
            <button id="btnPresetMalware" class="text-xs px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-medium transition cursor-pointer">
              <i class="fa-solid fa-bug mr-1"></i> Spyware Calculator
            </button>
            <button id="btnPresetFitness" class="text-xs px-2.5 py-1 rounded-lg bg-cyan-50 hover:bg-cyan-100 text-cyan-700 border border-cyan-200 font-medium transition cursor-pointer">
              <i class="fa-solid fa-heart-pulse mr-1"></i> Fitness Band
            </button>
            <button id="btnClearCustomInput" class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium transition cursor-pointer">
              Clear
            </button>
          </div>
        </div>

        <textarea id="customManifestTextarea" rows="4" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-xs font-mono text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" placeholder="android.permission.ACCESS_FINE_LOCATION&#10;android.permission.RECORD_AUDIO&#10;android.permission.READ_CONTACTS&#10;android.permission.CAMERA"></textarea>
        
        <div class="mt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <span class="text-[11px] text-slate-500">
            Accepts full identifiers (<code class="bg-slate-100 px-1 py-0.5 rounded text-slate-700">android.permission.XYZ</code>) or shorthand names (<code class="bg-slate-100 px-1 py-0.5 rounded text-slate-700">RECORD_AUDIO</code>).
          </span>
          <button id="btnRunCustomAudit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-md shadow-emerald-600/30 flex items-center justify-center gap-2 transition cursor-pointer">
            <i class="fa-solid fa-magnifying-glass-chart"></i>
            <span>Audit Pasted Permissions</span>
          </button>
        </div>
      </section>

      <!-- App Overview Card + Plain-English "What This Means for You" Summary -->
      <section id="appOverviewBanner" class="p-5 sm:p-6 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-xl space-y-4">
        
        <!-- App Identity Row -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center space-x-4">
            <div id="bannerAppIconContainer" class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-sm shrink-0 bg-black text-rose-400">
              <i id="bannerAppIcon" class="fa-brands fa-tiktok"></i>
            </div>
            <div>
              <div class="flex items-center flex-wrap gap-2">
                <h3 id="bannerAppName" class="text-xl font-extrabold text-slate-900">TikTok</h3>
                <span id="bannerCategoryTag" class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 font-bold">Social Media</span>
                <span id="bannerAnomalyBadge" class="hidden text-xs px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 border border-rose-300 font-bold animate-pulse">
                  <i class="fa-solid fa-triangle-exclamation mr-1"></i> Suspicious / Spyware Indicator
                </span>
              </div>
              <p id="bannerAppDescription" class="text-xs sm:text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed font-medium">
                Short-form video entertainment platform requesting aggressive ambient sensors and biometric markers.
              </p>
            </div>
          </div>

          <!-- Clean Monitored Count (Single Source of Score Truth is the Dial) -->
          <div class="self-start sm:self-center shrink-0">
            <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700">
              <i class="fa-solid fa-list-check text-emerald-600"></i>
              <span id="bannerPermCount">9 Permissions Monitored</span>
            </span>
          </div>
        </div>

        <!-- ================= PLAIN-ENGLISH "WHAT THIS MEANS FOR YOU" ================= -->
        <div class="pt-4 border-t border-slate-200">
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">
                <i class="fa-solid fa-user-shield"></i>
              </div>
              <h4 class="text-xs font-extrabold uppercase tracking-wider text-slate-900">What This Means for You</h4>
            </div>
            <span class="text-[11px] text-slate-500 font-medium hidden sm:inline">Plain Human Translation of Everyday Privacy Impact</span>
          </div>

          <!-- 3 Dynamic Plain-English Human Impact Bullets -->
          <div id="whatMeansForYouContainer" class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <!-- Dynamically populated via JS -->
          </div>
        </div>

      </section>

      <!-- ================= 3. AUDIT DASHBOARD (DIAL + CHECKLIST) ================= -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left Column: Single Source of Truth Risk Score Dial & Metrics (4 cols) -->
        <div class="lg:col-span-4 space-y-4">
          
          <!-- Single Source of Truth Dial Card -->
          <div class="p-6 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-xl flex flex-col items-center justify-center relative overflow-hidden">
            
            <div class="w-full flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
                <i class="fa-solid fa-gauge-high text-emerald-600"></i>
                Privacy Threat Meter
              </span>
              <span id="verdictPill" class="text-xs font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 border border-rose-300">
                High Risk
              </span>
            </div>

            <!-- SVG Gauge Meter -->
            <div class="relative w-56 h-56 my-2 flex items-center justify-center">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 160 160">
                <!-- Background Circle Track -->
                <circle cx="80" cy="80" r="65" stroke-width="13" stroke="#e2e8f0" fill="transparent" stroke-linecap="round"/>
                <!-- Dynamic Colored Ring -->
                <circle id="gaugeArc" class="gauge-progress-circle" cx="80" cy="80" r="65" stroke-width="13" 
                        stroke="#f43f5e" fill="transparent" stroke-linecap="round"
                        stroke-dasharray="408.4" stroke-dashoffset="60"/>
              </svg>

              <!-- Center Score Display -->
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <div id="dialScoreNumber" class="text-5xl font-black font-mono tracking-tight text-rose-600 transition-all duration-300">
                  86
                </div>
                <div class="text-[11px] font-bold uppercase text-slate-500 tracking-wider mt-0.5">Threat Score</div>
                
                <!-- Hardening Delta Pill -->
                <div id="dialDeltaBadge" class="mt-2 text-[11px] font-mono font-bold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-300 hidden">
                  <i class="fa-solid fa-arrow-down mr-0.5"></i> -0 pts hardened
                </div>
              </div>
            </div>

            <!-- Risk Threshold Visual Scale -->
            <div class="w-full space-y-1.5">
              <div class="flex justify-between text-[11px] font-mono font-semibold">
                <span class="text-emerald-700 font-bold">0 Safe</span>
                <span class="text-amber-700 font-bold">50 Moderate</span>
                <span class="text-rose-700 font-bold">100 Critical</span>
              </div>
              <div class="w-full h-2 rounded-full bg-slate-100 p-0.5 flex gap-1 border border-slate-200">
                <div class="flex-1 rounded-l-full bg-emerald-500"></div>
                <div class="flex-1 bg-amber-500"></div>
                <div class="flex-1 rounded-r-full bg-rose-500"></div>
              </div>
            </div>

            <!-- Dynamic Plain-English Threat Verdict -->
            <div id="dialNarrativeBox" class="w-full mt-4 p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-700 leading-relaxed font-medium">
              <div class="flex items-start gap-2">
                <span class="text-base shrink-0 leading-none">🚨</span>
                <div>
                  <div class="font-bold text-rose-800 text-xs">High Danger</div>
                  <div class="text-[11px] text-slate-600 mt-0.5 leading-relaxed font-medium">This app has access to your most private phone sensors (mic, location, files). Turn off permissions you don't need below.</div>
                </div>
              </div>
            </div>

            <!-- Reset to Defaults Button -->
            <div class="w-full mt-3 pt-3 border-t border-slate-200 flex justify-end">
              <button id="btnResetToDefaults" class="text-xs text-slate-500 hover:text-slate-800 font-semibold flex items-center gap-1.5 transition cursor-pointer">
                <i class="fa-solid fa-rotate-left"></i>
                <span>Reset to App Defaults</span>
              </button>
            </div>

          </div>

          <!-- Quick Metrics Grid -->
          <div class="grid grid-cols-2 gap-3">
            
            <div class="p-4 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-md flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-blue-100 border border-blue-200 flex items-center justify-center text-blue-600 text-base shrink-0">
                <i class="fa-solid fa-star"></i>
              </div>
              <div>
                <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Core Features</div>
                <div id="statCoreCount" class="text-lg font-black text-slate-900 font-mono">4</div>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-md flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-100 border border-emerald-200 flex items-center justify-center text-emerald-600 text-base shrink-0">
                <i class="fa-solid fa-shield"></i>
              </div>
              <div>
                <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Mitigated / Safe</div>
                <div id="statHardenedCount" class="text-lg font-black text-emerald-600 font-mono">0</div>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-md flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-cyan-100 border border-cyan-200 flex items-center justify-center text-cyan-700 text-base shrink-0">
                <i class="fa-solid fa-arrow-trend-down"></i>
              </div>
              <div>
                <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Threat Reduction</div>
                <div id="statPointsReduced" class="text-lg font-black text-cyan-700 font-mono">0 pts</div>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-md flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-rose-100 border border-rose-200 flex items-center justify-center text-rose-600 text-base shrink-0">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </div>
              <div>
                <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Suspicious Flags</div>
                <div id="statAnomaliesCount" class="text-lg font-black text-rose-600 font-mono">0</div>
              </div>
            </div>

          </div>

          <!-- Export Config Button Card -->
          <div class="p-4 rounded-2xl bg-white text-slate-900 border border-slate-200 shadow-md space-y-2.5">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-file-arrow-down text-emerald-600"></i>
              <h4 class="text-xs font-extrabold uppercase tracking-wider text-slate-900">Download Phone Action Plan</h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed font-medium">
              Export a concise summary checklist with step-by-step Android and iOS settings guides.
            </p>
            <button id="btnExportHardenedConfig" class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md flex items-center justify-center gap-2 transition cursor-pointer">
              <i class="fa-solid fa-download text-emerald-400"></i>
              <span>Export Privacy Config (.txt)</span>
            </button>
          </div>

        </div>

