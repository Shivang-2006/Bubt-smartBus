        isSuspicious: false,
        permissions: [
          { perm: 'CAMERA', baseWeight: 14, tier: 'core', coreImpact: 'Disabling Camera prevents recording Stories, Reels, or taking photos directly in the app.', state: 'full', customNote: 'Used to snap photos, record Reels, and take Stories.' },
          { perm: 'RECORD_AUDIO', baseWeight: 14, tier: 'core', coreImpact: 'Disabling Mic mutes sound in Reels and direct video messages.', state: 'full', customNote: 'Captures microphone sound while you record videos or voice messages.' },
          { perm: 'READ_EXTERNAL_STORAGE', baseWeight: 8, tier: 'core', coreImpact: 'Disabling Storage blocks uploading photos or videos from your phone gallery.', state: 'full', customNote: 'Opens your photo gallery so you can pick pictures and videos to post.' },
          { perm: 'INTERNET', baseWeight: 4, tier: 'core', coreImpact: 'Disabling Internet blocks feed loading, direct messages, and stories.', state: 'full', customNote: 'Streams photos and videos from Meta servers and synchronizes your feed.' },
          { perm: 'ACCESS_FINE_LOCATION', baseWeight: 16, tier: 'optional', coreImpact: 'Optional: Auto-tagging nearby venues is disabled; you can still type location tags manually.', state: 'full', customNote: 'Tags locations on your posts and shows nearby venues and local ads.' },
          { perm: 'READ_CONTACTS', baseWeight: 14, tier: 'optional', coreImpact: 'Optional: Address book friend sync disabled; you can still search friends by username.', state: 'full', customNote: 'Checks your address book to suggest friends and sync contacts with Meta.' },
          { perm: 'POST_NOTIFICATIONS', baseWeight: 4, tier: 'optional', coreImpact: 'Optional: Mutes push notification popups for DMs, likes, and comments.', state: 'full', customNote: 'Alerts you about new direct messages, likes, and comments.' }
        ]
      },
      'flashlight': {
        id: 'flashlight',
        name: 'Flashlight Pro',
        category: 'Utility (Spyware Pattern)',
        iconClass: 'fa-solid fa-bolt',
        iconBg: 'bg-amber-100 text-amber-600 border border-amber-300',
        description: '🚨 MALWARE PATTERN: A torch utility that only needs camera LED flash, yet requests microphone, contacts, and GPS tracking!',
        baselineScore: 100,
        isSuspicious: true,
        permissions: [
          { perm: 'CAMERA', baseWeight: 4, tier: 'core', coreImpact: 'Turns off LED hardware. Torch will not emit light.', state: 'full', customNote: 'Legitimate: Needed strictly to turn on the camera flash LED light.' },
          { perm: 'RECORD_AUDIO', baseWeight: 18, tier: 'suspicious', coreImpact: 'None. Safe to block: A torch utility has ZERO legitimate reason to listen to audio.', state: 'full', customNote: '🚨 Suspicious: A flashlight only needs an LED light! Listening to room audio is a major red flag.' },
          { perm: 'READ_CONTACTS', baseWeight: 18, tier: 'suspicious', coreImpact: 'None. Safe to block: Torch functions 100% without your phone contact list.', state: 'full', customNote: '🚨 Suspicious: A torch has no reason to read your contact book. This data can be sold to advertisers.' },
          { perm: 'ACCESS_FINE_LOCATION', baseWeight: 18, tier: 'suspicious', coreImpact: 'None. Safe to block: GPS tracking is completely unrelated to flashlight operation.', state: 'full', customNote: '🚨 Suspicious: A flashlight does not need your GPS location. It may be selling your location data.' },
          { perm: 'READ_CALL_LOG', baseWeight: 18, tier: 'suspicious', coreImpact: 'None. Safe to block: Reading private call logs is dangerous spyware behavior for a torch.', state: 'full', customNote: '🚨 Suspicious: Reading your private call history is dangerous spyware behavior for a torch.' },
          { perm: 'READ_PHONE_STATE', baseWeight: 14, tier: 'suspicious', coreImpact: 'None. Safe to block: Grabs hardware serial numbers to track device on ad networks.', state: 'full', customNote: '🚨 Suspicious: Grabs your device serial number (IMEI) to track your phone across ad networks.' },
          { perm: 'SYSTEM_ALERT_WINDOW', baseWeight: 12, tier: 'suspicious', coreImpact: 'None. Safe to block: Prevents intrusive pop-up ads over other apps.', state: 'full', customNote: '🚨 Suspicious: Can pop up intrusive ads over your other apps and screens.' }
        ]
      },
      'signal': {
        id: 'signal',
        name: 'Signal Messenger',
        category: 'Secure Private Messaging',
        iconClass: 'fa-solid fa-comment-sms',
        iconBg: 'bg-blue-600 text-white',
        description: 'Open-source, end-to-end encrypted private messenger engineered for zero metadata retention.',
        baselineScore: 25,
        isSuspicious: false,
        permissions: [
          { perm: 'INTERNET', baseWeight: 4, tier: 'core', coreImpact: 'Disabling Internet blocks sending and receiving encrypted messages.', state: 'full', customNote: 'Connects to Signal’s secure servers using private encrypted channels.' },
          { perm: 'RECORD_AUDIO', baseWeight: 14, tier: 'core', coreImpact: 'Disabling Mic blocks encrypted phone calls and audio voice memos.', state: 'full', customNote: 'Used strictly when you make an encrypted voice call or send a voice memo.' },
          { perm: 'CAMERA', baseWeight: 12, tier: 'core', coreImpact: 'Disabling Camera blocks taking encrypted photos or making secure video calls.', state: 'full', customNote: 'Used strictly when you take a photo to send or make an encrypted video call.' },
          { perm: 'READ_EXTERNAL_STORAGE', baseWeight: 8, tier: 'core', coreImpact: 'Disabling Storage blocks local encrypted database backups.', state: 'full', customNote: 'Stores your encrypted message history and media safely on your device.' },
          { perm: 'READ_CONTACTS', baseWeight: 10, tier: 'optional', coreImpact: 'Optional: Secure contact discovery disabled; you can still message users by phone number.', state: 'full', customNote: 'Matches your contacts securely using mathematical privacy codes; raw numbers are never uploaded.' },
          { perm: 'POST_NOTIFICATIONS', baseWeight: 4, tier: 'optional', coreImpact: 'Optional: Message alerts won\'t pop up until you open the app.', state: 'full', customNote: 'Notifies you when you receive new secure messages.' }
        ]
      },
      'custom': {
        id: 'custom',
        name: 'Custom Manifest Audit',
        category: 'Manual Audit / Manifest',
        iconClass: 'fa-solid fa-terminal',
        iconBg: 'bg-cyan-100 text-cyan-700 border border-cyan-300',
        description: 'Custom permission manifest analyzer with real-time semantic translation and threat assessment.',
        baselineScore: 0,
        isSuspicious: false,
        permissions: []
      }
    };

    // --- 3. Reactive State ---
    let currentAppKey = 'tiktok';
    let currentPermissions = [];
    let activeCategory = 'all';
    let searchQuery = '';

    // --- 4. Bootstrap on DOM Ready ---
    document.addEventListener('DOMContentLoaded', () => {
      initApp('tiktok');
      registerEventListeners();
    });

    // --- 5. Event Listeners ---
    function registerEventListeners() {
      // App selector tabs
      document.querySelectorAll('.app-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const app = btn.dataset.app;
          initApp(app);
        });
      });

      // Primary Category filter pills
      document.querySelectorAll('.cat-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.cat-pill').forEach(p => {
            p.classList.remove('active', 'bg-slate-900', 'text-white', 'shadow-sm');
            p.classList.add('bg-slate-100', 'text-slate-700');
          });
          pill.classList.add('active', 'bg-slate-900', 'text-white', 'shadow-sm');
          pill.classList.remove('bg-slate-100', 'text-slate-700');
          activeCategory = pill.dataset.cat;
          renderPermissionCards();
        });
      });

      // Search input
      const searchBox = document.getElementById('permissionSearchInput');
      searchBox.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        renderPermissionCards();
      });

      // Reset filters button
      document.getElementById('btnResetSearchFilters').addEventListener('click', () => {
        searchQuery = '';
        searchBox.value = '';
        activeCategory = 'all';
        document.querySelector('.cat-pill[data-cat="all"]').click();
      });

      // 1-Click "Apply Recommended Privacy Fix" Action
      document.getElementById('btnApplyRecommendedFix').addEventListener('click', applyRecommendedPrivacyFix);

      // Interactive 10s Demo Tour
      const demoBtn = document.getElementById('btnRunInteractiveDemo');
      if (demoBtn) demoBtn.addEventListener('click', runInteractiveDemo);

      // Reset to defaults
      document.getElementById('btnResetToDefaults').addEventListener('click', () => {
        initApp(currentAppKey);
      });

      // Export Config CTA
      document.getElementById('btnExportHardenedConfig').addEventListener('click', exportHardenedConfigFile);

      // Collapsible Guide
      const guideHeader = document.getElementById('phoneGuideHeader');
      const guideBody = document.getElementById('phoneGuideBody');
      const guideChevron = document.getElementById('guideChevronIcon');
      guideHeader.addEventListener('click', () => {
        const isHidden = guideBody.classList.contains('hidden');
        guideBody.classList.toggle('hidden');
        guideChevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
      });

      // Methodology Modal
      const modal = document.getElementById('methodologyModal');
      document.getElementById('btnOpenMethodology').addEventListener('click', () => modal.classList.remove('hidden'));
      document.getElementById('btnCloseMethodologyModal').addEventListener('click', () => modal.classList.add('hidden'));
      document.getElementById('btnDismissMethodologyModal').addEventListener('click', () => modal.classList.add('hidden'));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      });

      // Custom Paste Handlers
      document.getElementById('btnRunCustomAudit').addEventListener('click', processCustomPermissions);
      document.getElementById('btnClearCustomInput').addEventListener('click', () => {
        document.getElementById('customManifestTextarea').value = '';
      });
      document.getElementById('btnPresetMalware').addEventListener('click', () => {
        document.getElementById('customManifestTextarea').value = 
`android.permission.RECORD_AUDIO
android.permission.ACCESS_FINE_LOCATION
android.permission.READ_CONTACTS
android.permission.READ_SMS
android.permission.SYSTEM_ALERT_WINDOW
android.permission.INTERNET`;
        processCustomPermissions();
      });
      document.getElementById('btnPresetFitness').addEventListener('click', () => {
        document.getElementById('customManifestTextarea').value = 
`android.permission.ACCESS_FINE_LOCATION
android.permission.ACTIVITY_RECOGNITION
android.permission.BODY_SENSORS
android.permission.BLUETOOTH_SCAN
android.permission.POST_NOTIFICATIONS
android.permission.INTERNET`;
        processCustomPermissions();
      });
    }

    // --- 6. Application Loader ---
    function initApp(appKey) {
      currentAppKey = appKey;
      const appData = APPS_DATABASE[appKey];

      // Highlight active tab
      document.querySelectorAll('.app-tab-btn').forEach(btn => {
        const isActive = btn.dataset.app === appKey;
        if (isActive) {
          btn.classList.add('border-emerald-500', 'bg-slate-800', 'ring-2', 'ring-emerald-500/30');
          btn.classList.remove('border-slate-800', 'bg-slate-850');
        } else {
          btn.classList.remove('border-emerald-500', 'bg-slate-800', 'ring-2', 'ring-emerald-500/30');
          btn.classList.add('border-slate-800', 'bg-slate-850');
        }
      });

      // Show/Hide Custom Paste Drawer
      const customDrawer = document.getElementById('customPasteDrawer');
      if (appKey === 'custom') {
        customDrawer.classList.remove('hidden');
        if (currentPermissions.length === 0) {
          document.getElementById('customManifestTextarea').value = 
`android.permission.ACCESS_FINE_LOCATION
android.permission.RECORD_AUDIO
android.permission.READ_CONTACTS
android.permission.CAMERA
android.permission.READ_CLIPBOARD
android.permission.POST_NOTIFICATIONS`;
          processCustomPermissions();
          return;
        }
      } else {
        customDrawer.classList.add('hidden');
      }

      // Deep clone permissions
      currentPermissions = JSON.parse(JSON.stringify(appData.permissions));

      // Update Banner UI
      const iconContainer = document.getElementById('bannerAppIconContainer');
      iconContainer.className = `w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-sm shrink-0 ${appData.iconBg}`;
      document.getElementById('bannerAppIcon').className = appData.iconClass;
      document.getElementById('bannerAppName').textContent = appData.name;
      document.getElementById('bannerCategoryTag').textContent = appData.category;
      document.getElementById('bannerAppDescription').textContent = appData.description;

      const anomalyBadge = document.getElementById('bannerAnomalyBadge');
      if (appData.isSuspicious) {
        anomalyBadge.classList.remove('hidden');
      } else {
        anomalyBadge.classList.add('hidden');
      }

      document.getElementById('bannerPermCount').textContent = `${currentPermissions.length} Permissions Monitored`;

      // Reset filters & render
      searchQuery = '';
      document.getElementById('permissionSearchInput').value = '';
      activeCategory = 'all';
      document.querySelector('.cat-pill[data-cat="all"]').click();

      updateLiveAuditState();
      renderPermissionCards();
      renderWhatMeansForYou();
    }

    // --- 7. Custom Paste Parser ---
    function processCustomPermissions() {
      const raw = document.getElementById('customManifestTextarea').value.trim();
      if (!raw) {
        alert('Please enter at least one permission string.');
        return;
      }

      const lines = raw.split('\n')
        .map(l => l.trim())
        .filter(l => l.length > 0);

      const parsed = [];
      const seen = new Set();

      lines.forEach(line => {
        let clean = line.replace(/['"<>,;]/g, '').trim();
        if (clean.includes('.')) {
          const parts = clean.split('.');
          clean = parts[parts.length - 1];
        }
        clean = clean.toUpperCase().replace(/\s+/g, '_');

        if (clean && !seen.has(clean)) {
          seen.add(clean);
          const dict = PERMISSION_DICTIONARY[clean];
          parsed.push({
            perm: clean,
            baseWeight: dict ? dict.defaultWeight : (clean.includes('LOCATION') ? 18 : (clean.includes('AUDIO') ? 18 : 10)),
            tier: 'optional',
            state: 'full',
            coreImpact: 'Optional feature entered via custom manifest.',
            customNote: 'Custom audited permission entered via manifest.'
          });
        }
      });

      APPS_DATABASE['custom'].permissions = parsed;
      currentPermissions = JSON.parse(JSON.stringify(parsed));

      document.getElementById('bannerPermCount').textContent = `${currentPermissions.length} Permissions Monitored`;

      updateLiveAuditState();
      renderPermissionCards();
      renderWhatMeansForYou();
    }

    // --- 8. Resolve Permission Details (Dictionary + Fallback) ---
    function resolvePermissionDetails(item) {
      const permKey = item.perm;
      const dict = PERMISSION_DICTIONARY[permKey];
      const sensitivePerms = [
        'RECORD_AUDIO', 'CAMERA', 'ACCESS_FINE_LOCATION', 'ACCESS_BACKGROUND_LOCATION',
        'READ_CONTACTS', 'WRITE_CONTACTS', 'READ_CLIPBOARD', 'READ_SMS', 'SEND_SMS',
        'READ_CALL_LOG', 'READ_PHONE_STATE', 'SYSTEM_ALERT_WINDOW'
      ];

      const tier = item.tier || (item.isAnomaly ? 'suspicious' : 'optional');
      const state = item.state || (item.allowed === false ? 'denied' : 'full');
      const supportsWhileInUse = dict ? (dict.supportsWhileInUse || false) : (permKey.includes('LOCATION') || permKey.includes('AUDIO') || permKey.includes('CAM'));
      const supportsApproximate = dict ? (dict.supportsApproximate || false) : (permKey.includes('LOCATION') && !permKey.includes('BACKGROUND'));
      const coreImpact = item.coreImpact || (tier === 'core' ? `Disabling this permission will prevent primary features in this app.` : 'Optional: Secondary feature convenience disabled.');

      if (dict) {
        return {
          name: dict.name,
          friendlyName: dict.friendlyName,
          category: dict.category,
          categoryIcon: dict.categoryIcon,
          severity: item.severity || dict.severity,
          baseWeight: item.baseWeight !== undefined ? item.baseWeight : (item.weight !== undefined ? item.weight : dict.defaultWeight),
          tier: tier,
          state: state,
          coreImpact: coreImpact,
          supportsWhileInUse: supportsWhileInUse,
          supportsApproximate: supportsApproximate,
          plainEnglish: item.plainEnglishOverride || dict.plainEnglish,
          whyItMatters: item.customNote || dict.whyItMatters,
          isSensitive: tier === 'suspicious' || item.isAnomaly || dict.isSensitive || sensitivePerms.includes(permKey)
        };
      }

      // Dynamic Fallback Heuristic
      const key = permKey.toUpperCase();
      let category = 'Storage';
      let icon = 'fa-microchip';
      let friendlyName = permKey.replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
      let severity = item.severity || 'Medium';
      let baseWeight = item.baseWeight !== undefined ? item.baseWeight : (item.weight !== undefined ? item.weight : 8);
      let plainEnglish = `Controls hardware or system capabilities for ${permKey.toLowerCase().replace(/_/g, ' ')}.`;
      let whyItMatters = item.customNote || 'Exposes internal system features and background device data.';
      let isSensitive = tier === 'suspicious' || item.isAnomaly || sensitivePerms.includes(key);

      if (key.includes('LOCATION') || key.includes('GPS')) {
        category = 'Location';
        icon = 'fa-location-dot';
        friendlyName = 'Precise Location Tracking';
        severity = 'Critical';
        baseWeight = 18;
        isSensitive = true;
        plainEnglish = 'Tracks your exact physical whereabouts down to street level.';
        whyItMatters = 'Allows the app to follow where you walk, drive, and visit.';
      } else if (key.includes('AUDIO') || key.includes('MIC') || key.includes('RECORD')) {
        category = 'Microphone';
        icon = 'fa-microphone';
        friendlyName = 'Microphone Audio Recording';
        severity = 'Critical';
        baseWeight = 18;
        isSensitive = true;
        plainEnglish = 'Can listen to your private conversations and background sounds.';
        whyItMatters = 'The app can record audio in the room even when you are not speaking.';
      } else if (key.includes('CAM')) {
        category = 'Camera';
        icon = 'fa-camera';
        friendlyName = 'Camera & Video Capture';
        severity = 'High';
        baseWeight = 14;
        isSensitive = true;
        plainEnglish = 'Can turn on your cameras to take pictures, record video, or scan surroundings.';
        whyItMatters = 'Gives the app visual access into your home and private spaces.';
      } else if (key.includes('CONTACT')) {
        category = 'Contacts';
        icon = 'fa-address-book';
        friendlyName = 'Personal Address Book';
        severity = 'High';
        baseWeight = 14;
        isSensitive = true;
        plainEnglish = 'Copies your entire list of saved contacts, phone numbers, and emails.';
        whyItMatters = 'Shares friends and family members’ personal numbers with remote servers.';
      } else if (key.includes('SMS') || key.includes('MMS')) {
        category = 'Contacts';
        icon = 'fa-envelope-open-text';
        friendlyName = 'Read Incoming Text Messages';
        severity = 'Critical';
        baseWeight = 20;
        isSensitive = true;
        plainEnglish = 'Can read private SMS messages and one-time two-factor security codes.';
        whyItMatters = 'Allows the app to read private messages and intercept bank login codes.';
      } else if (key.includes('STORAGE') || key.includes('FILE')) {
        category = 'Storage';
        icon = 'fa-hard-drive';
        friendlyName = 'Photos & Local File Storage';
        severity = 'Medium';
        baseWeight = 10;
        isSensitive = false;
        plainEnglish = 'Can view and open saved photos, media, and downloaded documents.';
        whyItMatters = 'Allows the app to open your saved pictures and files.';
      }

      return {
        name: permKey,
        friendlyName,
        category,
        categoryIcon: icon,
        severity,
        baseWeight,
        tier: tier,
        state: state,
        coreImpact: coreImpact,
        supportsWhileInUse: supportsWhileInUse,
        supportsApproximate: supportsApproximate,
        plainEnglish,
        whyItMatters: item.customNote || whyItMatters,
        isSensitive
      };
    }

    // --- 9. Refined Contextual Risk Score Calculation ---
    function calculateContextualScore(permsList) {
      if (!permsList || permsList.length === 0) return 0;
      let total = 0;

      permsList.forEach(p => {
        const meta = resolvePermissionDetails(p);

        // 1. Contextual tier multiplier (app purpose awareness)
        let tierMultiplier = 1.0;
        if (meta.tier === 'core') {
          tierMultiplier = 0.30; // Core permissions have legitimate contextual justification
        } else if (meta.tier === 'suspicious') {
          tierMultiplier = 1.60; // Suspicious permissions are heavily penalized
        } else {
          tierMultiplier = 1.00; // Optional standard feature
        }

        // 2. Mitigation state multiplier (modern OS controls)
        let stateMultiplier = 0;
        if (meta.state === 'full') {
          stateMultiplier = 1.0;
        } else if (meta.state === 'while_in_use') {
          stateMultiplier = 0.35; // Foreground only mitigates background surveillance
        } else if (meta.state === 'approximate') {
          stateMultiplier = 0.20; // Coarse masking mitigates exact GPS tracking
        } else if (meta.state === 'denied') {
          stateMultiplier = 0.0;  // Revoked completely
        }

        total += meta.baseWeight * tierMultiplier * stateMultiplier;
      });

      return Math.min(100, Math.round(total));
    }
    const computeRiskScore = calculateContextualScore;

    // --- 10. Live Audit Dashboard Updater ---
    function updateLiveAuditState() {
      const activeList = currentPermissions;
      const baseline = calculateContextualScore(activeList.map(p => ({ ...p, state: 'full' })));
      const currentScore = calculateContextualScore(activeList);

      const gaugeArc = document.getElementById('gaugeArc');
      const scoreNumber = document.getElementById('dialScoreNumber');
      const verdictPill = document.getElementById('verdictPill');
      const narrativeBox = document.getElementById('dialNarrativeBox');
      const deltaBadge = document.getElementById('dialDeltaBadge');

      const statCore = document.getElementById('statCoreCount');
      const statHardened = document.getElementById('statHardenedCount');
      const statReduced = document.getElementById('statPointsReduced');
      const statAnomalies = document.getElementById('statAnomaliesCount');

      // SVG Arc Math (Radius = 65 -> Circumference = 2 * PI * 65 = 408.4)
      const circumference = 408.4;
      const offset = circumference - (currentScore / 100) * circumference;
      gaugeArc.style.strokeDashoffset = offset;

      // Color coding & verdict thresholds
      let colorHex = '#10b981'; // Green
      let verdict = 'Safe / Low Risk';
      let pillClass = 'bg-emerald-100 text-emerald-800 border-emerald-300';
      let narrative = `
        <div class="flex items-start gap-2">
          <span class="text-base shrink-0 leading-none">✅</span>
          <div>
            <div class="font-bold text-emerald-800 text-xs">Protected & Safe</div>
            <div class="text-[11px] text-slate-600 mt-0.5 leading-relaxed font-medium">Core functions are safely active, while intrusive tracking sensors are either restricted or turned off.</div>
          </div>
        </div>
      `;

      if (currentScore > 70) {
        colorHex = '#f43f5e'; // Rose
        verdict = 'Critical Risk';
        pillClass = 'bg-rose-100 text-rose-800 border-rose-300';
        narrative = `
          <div class="flex items-start gap-2">
            <span class="text-base shrink-0 leading-none">🚨</span>
            <div>
              <div class="font-bold text-rose-800 text-xs">High Danger / Spyware Flags</div>
              <div class="text-[11px] text-slate-600 mt-0.5 leading-relaxed font-medium">This app has unrestricted access to invasive phone sensors (mic, location, or contacts) with suspicious or excessive exposure.</div>
            </div>
          </div>
        `;
      } else if (currentScore > 35) {
        colorHex = '#f59e0b'; // Amber
        verdict = 'Moderate Risk';
        pillClass = 'bg-amber-100 text-amber-800 border-amber-300';
        narrative = `
          <div class="flex items-start gap-2">
            <span class="text-base shrink-0 leading-none">⚠️</span>
            <div>
              <div class="font-bold text-amber-800 text-xs">Moderate Exposure</div>
              <div class="text-[11px] text-slate-600 mt-0.5 leading-relaxed font-medium">Some sensitive features are active. You can restrict them to "While In Use" or "Approximate" to reduce privacy risk without breaking the app.</div>
            </div>
          </div>
        `;
      }

      gaugeArc.setAttribute('stroke', colorHex);
      scoreNumber.textContent = currentScore;
      scoreNumber.style.color = colorHex;

      verdictPill.textContent = verdict;
      verdictPill.className = `text-xs font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full border ${pillClass}`;
      narrativeBox.innerHTML = narrative;

      // Hardening Delta Badge
      const drop = baseline - currentScore;
      if (drop > 0) {
        deltaBadge.classList.remove('hidden');
        deltaBadge.innerHTML = `<i class="fa-solid fa-arrow-down mr-0.5"></i> -${drop} pts (${Math.round((drop/baseline)*100)}% hardened)`;
      } else {
        deltaBadge.classList.add('hidden');
      }

      // Stats Counters
      let coreCount = 0;
      let hardenedCount = 0;
      let activeAnomalies = 0;

      activeList.forEach(p => {
        const meta = resolvePermissionDetails(p);
        if (meta.tier === 'core') {
          coreCount++;
        }
        if (meta.state === 'while_in_use' || meta.state === 'approximate' || meta.state === 'denied') {
          hardenedCount++;
        }
        if (meta.tier === 'suspicious' && meta.state !== 'denied') {
          activeAnomalies++;
        }
      });

      if (statCore) statCore.textContent = coreCount;
      if (statHardened) statHardened.textContent = hardenedCount;
      if (statReduced) statReduced.textContent = `-${drop} pts`;
      if (statAnomalies) statAnomalies.textContent = activeAnomalies;
    }

    // --- 11. Plain-English "What This Means for You" Summary Generator ---
    function renderWhatMeansForYou() {
      const container = document.getElementById('whatMeansForYouContainer');
      if (!container) return;

      const locItem = currentPermissions.find(p => p.perm.includes('LOCATION') || p.perm.includes('GPS'));
      const micItem = currentPermissions.find(p => p.perm.includes('AUDIO') || p.perm.includes('MIC'));
      const contactsItem = currentPermissions.find(p => p.perm.includes('CONTACT') || p.perm.includes('CALL_LOG'));
      const clipItem = currentPermissions.find(p => p.perm.includes('CLIPBOARD') || p.perm.includes('SMS'));

      const isLocRestricted = !locItem || locItem.state === 'denied' || locItem.state === 'approximate' || locItem.state === 'while_in_use';
      const isMicRestricted = !micItem || micItem.state === 'denied' || micItem.state === 'while_in_use';
      const isContactsDenied = !contactsItem || contactsItem.state === 'denied';

      let bullets = [];

      if (currentAppKey === 'tiktok') {
        if (isLocRestricted && isMicRestricted && isContactsDenied) {
          bullets = [
            { icon: '🟢', title: 'Location Masked / Shielded', desc: 'Continuous GPS tracking prevented; location is masked or coarse city-level only.' },
            { icon: '🟢', title: 'Mic Restricted to In-Use Only', desc: 'Audio recording only functions while recording video clips, blocking background snooping.' },
            { icon: '🟢', title: 'Video Feed Preserved', desc: 'Camera, sound, and video playback operate normally for creating and watching content.' }
          ];
        } else {
          bullets = [
            { icon: '🔴', title: 'Can Track Your Exact Location 24/7', desc: 'Continuously logs street GPS coordinates to map where you live, work, and commute.' },
            { icon: '🔴', title: 'Can Listen via Background Microphone', desc: 'Captures ambient room audio for sound synthesis and acoustic ad targeting.' },
            { icon: '🟡', title: 'Accesses Clipboard & Contact Book', desc: 'Snoops on recently copied text (passwords, links) and harvests phone contact lists.' }
          ];
        }
      } else if (currentAppKey === 'instagram') {
        if (isLocRestricted && isContactsDenied) {
          bullets = [
            { icon: '🟢', title: 'Locations Kept Private', desc: 'Real-world GPS coordinates are masked; venue tags remain manual only.' },
            { icon: '🟢', title: 'Contacts Kept Safe', desc: 'Address book phone numbers are shielded from cross-network Facebook ad graphs.' },
            { icon: '🟢', title: 'Reels & Stories Protected', desc: 'Camera and mic are restricted to in-app use only, eliminating background eavesdropping.' }
          ];
        } else {
          bullets = [
            { icon: '🔴', title: 'Logs Exact Location & Venue Spots', desc: 'Records precise GPS coordinates and venue check-ins when publishing posts.' },
            { icon: '🟡', title: 'Uploads Your Personal Address Book', desc: 'Cross-references personal contacts to build targeted advertising graphs.' },
            { icon: '🟢', title: 'On-Demand Camera & Mic (Core)', desc: 'Microphone and camera are recognized as core features for capturing photos, Stories, and Reels.' }
          ];
        }
      } else if (currentAppKey === 'flashlight') {
        if (isLocRestricted && isMicRestricted && isContactsDenied) {
          bullets = [
            { icon: '🟢', title: 'Spyware Eavesdropping Blocked', desc: 'The torch has been disarmed of microphone access; room conversations cannot be recorded.' },
            { icon: '🟢', title: 'Contacts & Phone Logs Shielded', desc: 'Data brokers cannot scrape your phone call history or address book.' },
            { icon: '🟢', title: 'Flashlight Fully Functional', desc: 'Camera flash hardware LED is preserved with zero invasive spyware telemetry.' }
          ];
        } else {
          bullets = [
            { icon: '🚨', title: 'Covert Audio Eavesdropping', desc: 'A flashlight has ZERO legitimate need to record audio: indicates spyware surveillance.' },
            { icon: '🚨', title: 'Steals Call History & Address Book', desc: 'Silently harvests full phone call logs and contact lists to sell to data brokers.' },
            { icon: '🚨', title: 'Continuous GPS Surveillance', desc: 'Continuously broadcasts your physical movement to commercial ad brokers.' }
          ];
        }
      } else if (currentAppKey === 'signal') {
        bullets = [
          { icon: '🟢', title: 'End-to-End Encrypted Core Features', desc: 'Microphone and camera are essential for private voice/video calls and cannot be intercepted.' },
          { icon: '🟢', title: 'Private Cryptographic Contacts', desc: 'Contacts are matched via mathematical hashes; raw phone numbers are never stored.' },
          { icon: '🟢', title: 'Zero Unjustified Permissions', desc: 'Clean security architecture with zero location tracking, adware, or background snooping.' }
        ];
      } else {
        // Custom or Arbitrary Manifest
        if (locItem && locItem.state === 'full') {
          bullets.push({ icon: '🔴', title: 'Precise Location Tracking', desc: 'App can track your exact GPS coordinates and physical whereabouts.' });
        } else {
          bullets.push({ icon: '🟢', title: 'Location Protected / Masked', desc: 'Physical GPS tracking is restricted or turned off.' });
        }
        if (micItem && micItem.state === 'full') {
          bullets.push({ icon: '🔴', title: 'Microphone Audio Access', desc: 'App can capture microphone audio, conversations, and room acoustics.' });
        } else {
          bullets.push({ icon: '🟢', title: 'Microphone Shielded', desc: 'Microphone is restricted to in-use only or muted.' });
        }
        if (contactsItem && contactsItem.state === 'full') {
          bullets.push({ icon: '🟡', title: 'Address Book Access', desc: 'App can read personal phone numbers and contact associations.' });
        } else if (clipItem && clipItem.state === 'full') {
          bullets.push({ icon: '🔴', title: 'Sensitive Text Snooping', desc: 'App can inspect copied clipboard text or incoming messages.' });
        } else {
          bullets.push({ icon: '🟢', title: 'Contacts & Files Safe', desc: 'Address book and sensitive phone logs are safeguarded.' });
        }
      }

      container.innerHTML = bullets.map(b => `
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 hover:bg-slate-100/70 border border-slate-200 shadow-sm flex items-start gap-3.5 transition">
          <span class="text-xl sm:text-2xl shrink-0 mt-0.5">${b.icon}</span>
          <div class="space-y-1">
            <div class="text-sm sm:text-base font-extrabold text-slate-900 leading-snug">${b.title}</div>
            <div class="text-sm text-slate-700 font-medium leading-relaxed">${b.desc}</div>
          </div>
        </div>
      `).join('');
    }

    // --- 12. 1-Click "Apply Recommended Privacy Fix" Action ---
    function applyRecommendedPrivacyFix() {
      currentPermissions.forEach(p => {
        const meta = resolvePermissionDetails(p);

        if (currentAppKey === 'flashlight') {
          // For Flashlight, only CAMERA (LED) is essential; everything else is spyware
          if (meta.tier === 'core') {
            p.state = 'full';
            p.allowed = true;
          } else {
            p.state = 'denied';
            p.allowed = false;
          }
        } else if (currentAppKey === 'tiktok') {
          if (p.perm === 'CAMERA' || p.perm === 'RECORD_AUDIO') {
            p.state = 'while_in_use';
            p.allowed = true;
          } else if (p.perm === 'ACCESS_FINE_LOCATION') {
            p.state = 'approximate';
            p.allowed = true;
          } else if (meta.tier === 'suspicious' || p.perm === 'READ_CLIPBOARD' || p.perm === 'READ_CONTACTS' || p.perm === 'ACTIVITY_RECOGNITION') {
            p.state = 'denied';
            p.allowed = false;
          } else {
            p.state = 'full';
            p.allowed = true;
          }
        } else if (currentAppKey === 'instagram') {
          if (p.perm === 'CAMERA' || p.perm === 'RECORD_AUDIO') {
            p.state = 'while_in_use';
            p.allowed = true;
          } else if (p.perm === 'ACCESS_FINE_LOCATION') {
            p.state = 'approximate';
            p.allowed = true;
          } else if (p.perm === 'READ_CONTACTS') {
            p.state = 'denied';
            p.allowed = false;
          } else {
            p.state = 'full';
            p.allowed = true;
          }
        } else if (currentAppKey === 'signal') {
          if (p.perm === 'CAMERA' || p.perm === 'RECORD_AUDIO') {
            p.state = 'while_in_use';
            p.allowed = true;
          } else {
            p.state = 'full';
            p.allowed = true;
          }
        } else {
          // Custom / Generic App
          if (meta.tier === 'suspicious') {
            p.state = 'denied';
            p.allowed = false;
          } else if (meta.tier === 'core') {
            if (meta.supportsWhileInUse) {
              p.state = 'while_in_use';
              p.allowed = true;
            } else {
              p.state = 'full';
              p.allowed = true;
            }
          } else {
            // Optional
            if (meta.supportsApproximate) {
              p.state = 'approximate';
              p.allowed = true;
            } else if (meta.supportsWhileInUse) {
              p.state = 'while_in_use';
              p.allowed = true;
            } else if (meta.isSensitive) {
              p.state = 'denied';
              p.allowed = false;
            } else {
              p.state = 'full';
              p.allowed = true;
            }
          }
        }
      });

      pulseScoreDial();
      updateLiveAuditState();
      renderPermissionCards();
      renderWhatMeansForYou();

      // Visual Confirmation on Button
      const fixBtnText = document.getElementById('btnApplyFixText');
      const originalText = fixBtnText.textContent;
      fixBtnText.innerHTML = '<i class="fa-solid fa-check text-emerald-600 mr-1"></i> Contextual Protection Applied!';
      setTimeout(() => {
        fixBtnText.textContent = originalText;
      }, 2500);
    }

    // --- 13. Render Permission Cards (Granular Controls & Impact Warnings) ---
    function renderPermissionCards() {
      const container = document.getElementById('permissionsCardContainer');
      const emptyState = document.getElementById('noMatchEmptyState');
      const counterBadge = document.getElementById('filteredMatchCountPill');

      container.innerHTML = '';
      let rendered = 0;

      currentPermissions.forEach((item, index) => {
        const meta = resolvePermissionDetails(item);

        // Filter Category
        if (activeCategory !== 'all' && meta.category.toLowerCase() !== activeCategory.toLowerCase()) {
          return;
        }

        // Filter Search
        if (searchQuery) {
          const searchHaystack = `${meta.name} ${meta.friendlyName} ${meta.plainEnglish} ${meta.whyItMatters} ${meta.category}`.toLowerCase();
          if (!searchHaystack.includes(searchQuery)) {
            return;
          }
        }

        rendered++;

        const isFull = meta.state === 'full';
        const isWhileInUse = meta.state === 'while_in_use';
        const isApprox = meta.state === 'approximate';
        const isDenied = meta.state === 'denied';

        const card = document.createElement('div');

        // Dynamic Card Framing & Colors
        let cardClasses = '';
        let stripeColor = '';
        let tierBadge = '';
        let statusBadge = '';

        if (meta.tier === 'core') {
          tierBadge = `<span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200 flex items-center gap-1 shrink-0"><i class="fa-solid fa-star text-blue-600"></i> Core Feature</span>`;
        } else if (meta.tier === 'suspicious') {
          tierBadge = `<span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-rose-600 text-white flex items-center gap-1 shadow-sm animate-pulse shrink-0"><i class="fa-solid fa-triangle-exclamation"></i> 🚨 Suspicious / Unjustified</span>`;
        } else {
          tierBadge = `<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 flex items-center gap-1 shrink-0"><i class="fa-solid fa-circle-check text-slate-500"></i> Optional Feature</span>`;
        }

        if (isDenied) {
          cardClasses = 'bg-emerald-50/50 border border-emerald-300 border-l-4 border-l-emerald-600 shadow-sm';
          stripeColor = 'bg-emerald-500';
          statusBadge = `<span class="text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2.5 py-1 rounded-lg border border-emerald-300 flex items-center gap-1 shrink-0"><i class="fa-solid fa-shield text-emerald-600"></i> Denied (Safest)</span>`;
        } else if (isWhileInUse) {
          cardClasses = 'bg-amber-50/30 border border-amber-300 border-l-4 border-l-amber-500 shadow-sm';
          stripeColor = 'bg-amber-500';
          statusBadge = `<span class="text-[11px] font-bold text-amber-800 bg-amber-100 px-2.5 py-1 rounded-lg border border-amber-300 flex items-center gap-1 shrink-0"><i class="fa-solid fa-clock text-amber-600"></i> While In Use (Restricted)</span>`;
        } else if (isApprox) {
          cardClasses = 'bg-teal-50/40 border border-teal-300 border-l-4 border-l-teal-600 shadow-sm';
          stripeColor = 'bg-teal-600';
          statusBadge = `<span class="text-[11px] font-bold text-teal-800 bg-teal-100 px-2.5 py-1 rounded-lg border border-teal-300 flex items-center gap-1 shrink-0"><i class="fa-solid fa-map-pin text-teal-600"></i> Approximate City Only</span>`;
        } else {
          // Full access
          if (meta.tier === 'suspicious') {
            cardClasses = 'bg-rose-50/80 border-2 border-rose-400 border-l-4 border-l-rose-600 shadow-md shadow-rose-100';
            stripeColor = 'bg-rose-600 animate-pulse';
            statusBadge = `<span class="text-[11px] font-bold text-rose-800 bg-rose-100 px-2.5 py-1 rounded-lg border border-rose-300 flex items-center gap-1 shrink-0"><i class="fa-solid fa-triangle-exclamation text-rose-600"></i> Full Access (Danger)</span>`;
          } else if (meta.tier === 'core') {
            cardClasses = 'bg-white border border-blue-200 border-l-4 border-l-blue-600 shadow-sm';
            stripeColor = 'bg-blue-600';
            statusBadge = `<span class="text-[11px] font-bold text-blue-800 bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-200 shrink-0">Full Access (Standard)</span>`;
          } else {
            cardClasses = 'bg-white border border-slate-200 border-l-4 border-l-slate-400 shadow-sm';
            stripeColor = 'bg-slate-400';
            statusBadge = `<span class="text-[11px] font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200 shrink-0">Full Access</span>`;
          }
        }

        card.className = `p-4 sm:p-5 rounded-2xl ${cardClasses} crisp-card shadow-sm space-y-3 relative overflow-hidden`;

        // Severity Tag
        let severityTag = '';
        if (meta.severity === 'Critical') {
          severityTag = `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-200 shrink-0">Critical Threat</span>`;
        } else if (meta.severity === 'High') {
          severityTag = `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200 shrink-0">High Risk</span>`;
        } else if (meta.severity === 'Medium') {
          severityTag = `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-800 border border-cyan-200 shrink-0">Medium</span>`;
        } else {
          severityTag = `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 shrink-0">Low / Safe</span>`;
        }

        // Granular Mitigation Buttons Control
        let buttonsHtml = `
          <div class="flex items-center p-1 rounded-xl bg-slate-100 border border-slate-200 gap-1 flex-wrap sm:flex-nowrap" data-perm-index="${index}">
            <button type="button" data-set-state="full" class="state-pill px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1 cursor-pointer ${
              isFull 
                ? (meta.tier === 'suspicious' ? 'bg-rose-600 text-white shadow-sm' : 'bg-slate-900 text-white shadow-sm') 
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
            }">
              <i class="fa-solid fa-unlock text-[10px]"></i>
              <span>Full</span>
            </button>
        `;

        if (meta.supportsWhileInUse) {
          buttonsHtml += `
            <button type="button" data-set-state="while_in_use" class="state-pill px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1 cursor-pointer ${
              isWhileInUse 
                ? 'bg-amber-500 text-white shadow-sm' 
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
            }">
              <i class="fa-solid fa-clock text-[10px]"></i>
              <span>While In Use</span>
            </button>
          `;
        }

        if (meta.supportsApproximate) {
          buttonsHtml += `
            <button type="button" data-set-state="approximate" class="state-pill px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1 cursor-pointer ${
              isApprox 
                ? 'bg-teal-600 text-white shadow-sm' 
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
            }">
              <i class="fa-solid fa-map-pin text-[10px]"></i>
              <span>Approximate</span>
            </button>
          `;
        }

        buttonsHtml += `
            <button type="button" data-set-state="denied" class="state-pill px-2.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1 cursor-pointer ${
              isDenied 
                ? 'bg-emerald-600 text-white shadow-sm' 
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
            }">
              <i class="fa-solid fa-ban text-[10px]"></i>
              <span>Denied</span>
            </button>
          </div>
        `;

        card.innerHTML = `
          <!-- Left Color Accent Stripe -->
          <div class="absolute left-0 top-0 bottom-0 w-1.5 ${stripeColor}"></div>

          <!-- Top Row: Friendly Permission Title + Technical ID + Segmented Controls -->
          <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3 pl-2.5">
            
            <div class="flex items-center space-x-3">
              <span class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 flex items-center justify-center text-sm shrink-0">
                <i class="fa-solid ${meta.categoryIcon}"></i>
              </span>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-sm font-extrabold text-slate-900">${meta.friendlyName}</span>
                  ${tierBadge}
                  ${severityTag}
                </div>
                <div class="font-mono text-[10px] text-slate-400 mt-0.5">${meta.name}</div>
              </div>
            </div>

            <!-- Segmented Mode Controls & Reassurance Badge -->
            <div class="flex items-center space-x-2 self-start xl:self-center flex-wrap gap-y-2">
              ${statusBadge}
              ${buttonsHtml}
            </div>

          </div>

          <!-- Card Body -->
          <div class="pl-2.5 space-y-2.5">
            
            <!-- Inline Functionality Impact Warning (When Core Permission is Denied) -->
            ${meta.tier === 'core' && isDenied ? `
              <div class="p-3.5 rounded-xl bg-amber-50 border-2 border-amber-300 flex items-start gap-2.5 text-xs text-amber-900">
                <i class="fa-solid fa-triangle-exclamation text-amber-600 text-base mt-0.5 shrink-0"></i>
                <div>
                  <div class="font-extrabold text-amber-950 flex items-center gap-1.5">
                    <span>⚠️ Functionality Impact Warning</span>
                  </div>
                  <div class="mt-1 text-amber-900 leading-snug font-medium">
                    ${meta.coreImpact}
                  </div>
                  ${meta.supportsWhileInUse ? `
                    <div class="mt-2 text-[11px] text-amber-900 font-semibold bg-amber-100/80 p-2 rounded-lg border border-amber-200 flex items-center gap-1.5">
                      <i class="fa-solid fa-lightbulb text-amber-600 shrink-0"></i>
                      <span>Recommendation: Set to <strong>"While In Use"</strong> instead of Denied to stop background tracking without breaking this app.</span>
                    </div>
                  ` : ''}
                </div>
              </div>
            ` : ''}

            <!-- Suspicious / Spyware Alert Callout -->
            ${meta.tier === 'suspicious' && !isDenied ? `
              <div class="p-3 rounded-xl bg-rose-50 border-2 border-rose-300 flex items-start gap-2.5 text-xs text-rose-900">
                <i class="fa-solid fa-triangle-exclamation text-rose-600 text-base mt-0.5 shrink-0 animate-pulse"></i>
                <div>
                  <div class="font-extrabold text-rose-950">🚨 Unjustified Spyware Pattern Detected!</div>
                  <div class="mt-0.5 text-rose-800 leading-snug font-medium">
                    This app has ZERO operational reason to access this sensor. We strongly recommend selecting <strong>"Denied"</strong>.
                  </div>
                </div>
              </div>
            ` : ''}

            <!-- Plain English Translation Box (1-2 punchy lines) -->
            <div class="p-3.5 rounded-xl ${meta.tier === 'suspicious' && !isDenied ? 'bg-white/90 border border-rose-200' : 'bg-slate-50 border border-slate-200'}">
              <div class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 mb-1 flex items-center gap-1.5">
                <i class="fa-solid fa-comment-dots text-xs"></i> Plain Human Translation:
              </div>
              <p class="text-xs sm:text-sm font-semibold text-slate-900 leading-snug">
                "${meta.plainEnglish}"
              </p>
            </div>

            <!-- Single Clean Line: Why It Matters -->
            <div class="text-xs text-slate-700 flex items-start gap-1.5 px-1 font-medium">
              <i class="fa-solid fa-circle-info text-slate-500 mt-0.5 shrink-0"></i>
              <span><strong class="text-slate-900">Why it matters:</strong> ${meta.whyItMatters}</span>
            </div>

          </div>
        `;

        container.appendChild(card);
      });

      // Bind granular segmented buttons
      container.querySelectorAll('.state-pill').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const parentContainer = btn.closest('[data-perm-index]');
          const idx = parseInt(parentContainer.dataset.permIndex, 10);
          const targetState = btn.dataset.setState;

          currentPermissions[idx].state = targetState;
          currentPermissions[idx].allowed = (targetState !== 'denied');

          pulseScoreDial();
          updateLiveAuditState();
          renderPermissionCards();
          renderWhatMeansForYou();
        });
      });

      // Update counters & empty state
      counterBadge.textContent = `${rendered} of ${currentPermissions.length}`;
      if (rendered === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    // --- 14. Dial Pulse Micro-interaction ---
    function pulseScoreDial() {
      const scoreNumber = document.getElementById('dialScoreNumber');
      scoreNumber.classList.add('scale-110');
      setTimeout(() => scoreNumber.classList.remove('scale-110'), 250);
    }

    // --- 15. Export Hardened Privacy Config File (.txt) ---
    function exportHardenedConfigFile() {
      const app = APPS_DATABASE[currentAppKey];
      const baseline = calculateContextualScore(currentPermissions.map(p => ({ ...p, state: 'full' })));
      const hardenedScore = calculateContextualScore(currentPermissions);
      const pointsDropped = baseline - hardenedScore;
      const dropPct = baseline > 0 ? Math.round((pointsDropped / baseline) * 100) : 0;

      const timestamp = new Date().toISOString();
      const auditHash = 'PRIVASEE-' + Math.random().toString(36).substring(2, 9).toUpperCase();

      const revokedList = [];
      const restrictedList = [];
      const protectedCoreList = [];

      currentPermissions.forEach(p => {
        const meta = resolvePermissionDetails(p);
        if (p.state === 'denied') {
          revokedList.push(`  [REVOKED / DENIED] ${meta.friendlyName} (${meta.name})\n     • Impact: ${meta.coreImpact}\n     • Why it matters: ${meta.whyItMatters}`);
        } else if (p.state === 'while_in_use' || p.state === 'approximate') {
          const modeName = p.state === 'while_in_use' ? 'While In Use Only' : 'Approximate Location Only';
          restrictedList.push(`  [RESTRICTED -> ${modeName.toUpperCase()}] ${meta.friendlyName} (${meta.name})\n     • Mitigation: Restricted to foreground/coarse mode to eliminate background snooping.\n     • Why it matters: ${meta.whyItMatters}`);
        } else {
          // Full access
          protectedCoreList.push(`  [KEPT ACTIVE] ${meta.friendlyName} (${meta.name})\n     • Tier: ${meta.tier.toUpperCase()} | Feature kept enabled for application stability.`);
        }
      });

      const report = 
`================================================================================
PRIVASEE — DIGITAL PRIVACY ASSISTANT
CONTEXTUAL AUDIT & HARDENING ACTION PLAN
================================================================================
Timestamp:       ${timestamp}
Audit Report ID: ${auditHash}
Target App:      ${app.name} (${app.category})
Engine:          PrivaSee v2.4 (Contextual Risk & App Purpose Awareness)

--------------------------------------------------------------------------------
1. EXECUTIVE CONTEXTUAL THREAT ASSESSMENT
--------------------------------------------------------------------------------
Initial Baseline Threat Score: ${baseline} / 100
Hardened Privacy Score:        ${hardenedScore} / 100
Total Threat Reduction:        -${pointsDropped} points (↓ ${dropPct}% threat reduction)
Current Security Posture:      ${hardenedScore <= 35 ? 'SAFE / LOW RISK' : (hardenedScore <= 70 ? 'MODERATE RISK' : 'CRITICAL RISK')}

Total Permissions Audited:     ${currentPermissions.length}
Permissions Revoked (Safe):    ${revokedList.length}
Permissions Restricted:        ${restrictedList.length}
Protected Core Permissions:    ${protectedCoreList.length}

--------------------------------------------------------------------------------
2. REVOKED PERMISSIONS (SAFE TO TURN OFF COMPLETELY)
--------------------------------------------------------------------------------
${revokedList.length > 0 ? revokedList.join('\n\n') : '  None — no permissions revoked.'}

--------------------------------------------------------------------------------
3. RESTRICTED PERMISSIONS (WHILE IN USE / APPROXIMATE ONLY)
--------------------------------------------------------------------------------
${restrictedList.length > 0 ? restrictedList.join('\n\n') : '  None — no permissions restricted.'}

--------------------------------------------------------------------------------
4. PROTECTED CORE PERMISSIONS (KEPT ENABLED FOR STABILITY)
--------------------------------------------------------------------------------
${protectedCoreList.length > 0 ? protectedCoreList.join('\n\n') : '  None — all permissions mitigated.'}

--------------------------------------------------------------------------------
5. OS ENFORCEMENT GUIDE (STEP-BY-STEP PHONE SETTINGS)
--------------------------------------------------------------------------------
FOR GOOGLE ANDROID USERS:
  1. Open Settings -> Apps -> ${app.name}.
  2. Tap 'Permissions'.
  3. For Section 2 (Revoked): Choose 'Don\'t Allow'.
  4. For Section 3 (Restricted):
     • Camera / Microphone: Choose 'Ask every time' or 'Allow only while using the app'.
     • Location: Select 'Allow only while using the app' and toggle OFF 'Use precise location'.
  5. For Section 4 (Protected Core): Leave enabled to avoid breaking app features.

FOR APPLE iOS USERS:
  1. Open Settings -> Scroll down to '${app.name}'.
  2. For Section 2 (Revoked): Switch OFF toggles for Contacts, Local Network, Tracking.
  3. For Section 3 (Restricted):
     • Tap 'Location' -> Choose 'While Using the App' and toggle OFF 'Precise Location'.
     • For Camera & Microphone: Can be toggled on/off per use in Settings.
  4. Open Settings -> Privacy & Security -> Tracking -> Turn OFF tracking for '${app.name}'.

================================================================================`;

      const blob = new Blob([report], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const downloadAnchor = document.createElement('a');
      downloadAnchor.href = url;
      downloadAnchor.download = `privasee-hardening-${currentAppKey}-${Date.now()}.txt`;
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      document.body.removeChild(downloadAnchor);
      URL.revokeObjectURL(url);
    }

    // --- 16. Automatic Guided Demo Mode ---
    function runInteractiveDemo() {
      // Remove any existing banner
      const existing = document.getElementById('demoTourBanner');
      if (existing) existing.remove();

      const demoBanner = document.createElement('div');
      demoBanner.id = 'demoTourBanner';
      demoBanner.className = 'fixed top-16 left-1/2 -translate-x-1/2 z-50 max-w-lg w-[92%] bg-slate-950/95 border-2 border-emerald-500 text-white p-3.5 rounded-2xl shadow-2xl backdrop-blur-md flex items-center justify-between gap-3 text-xs transition-all';
      demoBanner.innerHTML = `
        <div class="flex items-center gap-2.5">
          <span class="text-xl">✨</span>
          <div>
            <div class="font-extrabold text-emerald-400 uppercase tracking-wider text-[10px]" id="demoStepNum">Demo Step 1 of 4</div>
            <div class="font-bold text-white text-xs mt-0.5" id="demoStepMsg">Selecting Flashlight Pro (Threat Score: 100 / 100)...</div>
          </div>
        </div>
        <button onclick="document.getElementById('demoTourBanner').remove()" class="text-slate-400 hover:text-white font-bold p-1 cursor-pointer">✕</button>
      `;
      document.body.appendChild(demoBanner);

      // Step 1: Select Flashlight Pro
      initApp('flashlight');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Step 2 (after 2s): Highlight Spyware Anomaly
      setTimeout(() => {
        const msg = document.getElementById('demoStepMsg');
        const step = document.getElementById('demoStepNum');
        if (!msg) return;
        step.textContent = 'Demo Step 2 of 4';
        msg.textContent = 'Notice the 🚨 Suspicious badges: Microphone, Contacts, and GPS are unneeded for a torch!';

        const banner = document.getElementById('appOverviewBanner');
        banner.classList.add('ring-4', 'ring-rose-500/80');
        setTimeout(() => banner.classList.remove('ring-4', 'ring-rose-500/80'), 2200);
      }, 2200);

      // Step 3 (after 4.5s): Automatically trigger 1-click privacy fix
      setTimeout(() => {
        const msg = document.getElementById('demoStepMsg');
        const step = document.getElementById('demoStepNum');
        if (!msg) return;
        step.textContent = 'Demo Step 3 of 4';
        msg.textContent = 'Applying Contextual Fix... Keeps camera LED working, revokes all spyware!';

        const fixBtn = document.getElementById('btnApplyRecommendedFix');
        fixBtn.classList.add('ring-4', 'ring-white', 'scale-105');
        setTimeout(() => fixBtn.classList.remove('ring-4', 'ring-white', 'scale-105'), 1500);

        applyRecommendedPrivacyFix();
      }, 4800);

      // Step 4 (after 7.5s): Switch to Instagram to demonstrate Core Feature Awareness & "While In Use"
      setTimeout(() => {
        const msg = document.getElementById('demoStepMsg');
        const step = document.getElementById('demoStepNum');
        if (!msg) return;
        step.textContent = 'Demo Step 4 of 4';
        msg.textContent = 'Switching to Instagram: Camera & Mic are recognized as Core Features (46/100, no false alarm!)';

        initApp('instagram');
        setTimeout(() => {
          applyRecommendedPrivacyFix();
          const msg2 = document.getElementById('demoStepMsg');
          if (msg2) msg2.textContent = 'Hardened Instagram: Camera set to "While In Use", Location to "Approximate" (Score: 14/100)!';
        }, 1500);
      }, 7600);

      // Completion (after 12.5s)
      setTimeout(() => {
        const msg = document.getElementById('demoStepMsg');
        const step = document.getElementById('demoStepNum');
        if (!msg) return;
        step.textContent = '🎉 Contextual Engine Demo Complete!';
        msg.innerHTML = 'PrivaSee intelligently distinguishes essential features from malicious spyware.';
        
        setTimeout(() => {
          const banner = document.getElementById('demoTourBanner');
          if (banner) banner.remove();
        }, 5000);
      }, 12500);
    }
  </script>

</body>
</html>
