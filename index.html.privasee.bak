        <div id="phoneGuideBody" class="hidden mt-4 pt-4 border-t border-slate-200 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          
          <!-- Android Steps -->
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="flex items-center space-x-2 text-emerald-700 font-bold text-sm">
              <i class="fa-brands fa-android text-base"></i>
              <span>Google Android (Pixel, Samsung Galaxy, OnePlus)</span>
            </div>
            <ol class="list-decimal list-inside space-y-1.5 text-slate-700 leading-relaxed font-medium">
              <li>Open your phone <strong class="text-slate-900">Settings</strong> &gt; <strong class="text-slate-900">Apps</strong>.</li>
              <li>Tap the target app (e.g. <em>TikTok</em>, <em>Instagram</em>, or <em>Flashlight</em>).</li>
              <li>Tap <strong class="text-slate-900">Permissions</strong>.</li>
              <li>Select any sensitive permission (e.g. <em>Microphone</em> or <em>Location</em>).</li>
              <li>Choose <strong class="text-rose-600 font-bold">Don't allow</strong>.</li>
              <li>For Location: Toggle OFF <strong class="text-slate-900">"Use precise location"</strong> to stop exact street tracking.</li>
            </ol>
          </div>

          <!-- iOS Steps -->
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="flex items-center space-x-2 text-indigo-700 font-bold text-sm">
              <i class="fa-brands fa-apple text-base"></i>
              <span>Apple iOS (iPhone / iPad)</span>
            </div>
            <ol class="list-decimal list-inside space-y-1.5 text-slate-700 leading-relaxed font-medium">
              <li>Open phone <strong class="text-slate-900">Settings</strong> and scroll down to the app's name.</li>
              <li>Turn OFF green toggles for <strong class="text-slate-900">Microphone</strong>, <strong class="text-slate-900">Camera</strong>, or <strong class="text-slate-900">Contacts</strong>.</li>
              <li>Tap <strong class="text-slate-900">Location</strong> &gt; select <strong class="text-rose-600 font-bold">Never</strong> (or "While Using").</li>
              <li>Turn OFF <strong class="text-slate-900">Precise Location</strong>.</li>
              <li>Go to <strong class="text-slate-900">Settings &gt; Privacy & Security &gt; Tracking</strong> and disable tracking for this app.</li>
            </ol>
          </div>

        </div>
      </section>

