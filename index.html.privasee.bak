          { perm: 'READ_PHONE_STATE', baseWeight: 14, tier: 'suspicious', coreImpact: 'None. Safe to block: Permanent hardware IMEI tracking is non-essential for video viewing.', state: 'full', customNote: 'Reads phone hardware IDs to track this specific device across different accounts.' },
